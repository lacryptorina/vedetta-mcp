    "start:http": "node dist/index.js --http",
    "ledger": "node dist/index.js ledger",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "x402",
    "crypto",
    "sentiment",
    "market-intelligence",
    "usdc",
    "base",
    "pay-per-call",
    "ai-agents"
  ],
